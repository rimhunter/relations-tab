#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
shared="$here/TestRunner/shared"
[ -x "$shared/bin/test-map-determinism" ] || { echo "test-map-determinism: the shared runner is missing; run: git submodule update --init" >&2; exit 4; }
export RIMHUNTER_MOD_REPO="$here"
exec "$shared/bin/test-map-determinism" "$@"
