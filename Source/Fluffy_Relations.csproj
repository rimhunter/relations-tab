<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GameVersion Condition="'$(GameVersion)' != '1.6' And '$(GameVersion)' != '1.7'">invalid</GameVersion>
        <RimWorldRefVersion Condition="'$(GameVersion)' == '1.6'">1.6.4871</RimWorldRefVersion>
        <RimWorldRefVersion Condition="'$(GameVersion)' == '1.7'">1.7.5011-unstable</RimWorldRefVersion>
        <TargetFramework Condition="'$(GameVersion)' == '1.6'">net472</TargetFramework>
        <TargetFramework Condition="'$(GameVersion)' == '1.7'">net10.0</TargetFramework>
        <GameVersionConstant>RW_$(GameVersion.Replace('.', '_'))</GameVersionConstant>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <AssemblyName>Fluffy_Relations</AssemblyName>
        <RootNamespace>Fluffy_Relations</RootNamespace>
        <AssemblyTitle>Fluffy_Relations</AssemblyTitle>
        <Product>Fluffy_Relations</Product>
        <Copyright>Copyright © 2016-2021 Karel Kroeze (Fluffy), modifications Copyright © 2026 rimhunter</Copyright>
        <DefineConstants>$(DefineConstants);$(GameVersionConstant)</DefineConstants>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>$(MSBuildProjectDirectory)/../$(GameVersion)/Assemblies/</OutputPath>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <DebugType>portable</DebugType>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>

    <Target Name="RequireGameVersion" BeforeTargets="BeforeBuild;Restore" Condition="'$(GameVersion)' == 'invalid'">
        <Error Text="Set -p:GameVersion=1.6 or -p:GameVersion=1.7, or build the repo root (dotnet build) for both."/>
    </Target>

    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" PrivateAssets="all" ExcludeAssets="runtime"/>
    </ItemGroup>

    <Target Name="BuildMessage" AfterTargets="Build">
        <Message Text="Relations Tab for RimWorld $(GameVersion) -> $(OutputPath)" Importance="High"/>
    </Target>
</Project>
